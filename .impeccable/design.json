  "narrative": {
    "northStar": "The Engineering Journal",
    "overview": "A quiet native conversation workspace with an open center, soft violet controls and locally bundled Rethink Sans. Near-white light surfaces and graphite dark surfaces keep technical reading clear. A static diffuse light field and sourced Konecto wave give the empty chat atmosphere without placing geometry behind the results.\n\nThis record retains the implemented V4 editorial system and adds the local profile extension. The scope is English Android phone UI in both light and dark modes: chat, left conversation history with a compact profile footer/menu/editor, and development-only debug. Geometry uses dp and text uses sp. UI fixtures demonstrate presentation, not model quality, backend integration or physical-device performance.",
    "keyCharacteristics": [
      "Centered Hello and icon-only empty-chat toolbar.",
      "Soft gradient actions, outlined composer and restrained static background.",
      "Matched light/dark semantic roles with saved Light/Dark/System appearance choices.",
      "Complete technical evidence in readable cards and synchronized comparison columns."
    ],
    "rules": [
      {
        "name": "The Content First Rule",
        "body": "Show the sourced wave only on the empty, idle chat; remove its geometry while typing, sending or reading messages.",
        "section": "colors"
      },
      {
        "name": "The Context Stays Visible Rule",
        "body": "Preserve complete technical identifiers, units, unavailable states and source notes; retain native font scaling rather than shrinking data to fit.",
        "section": "typography"
      },
      {
        "name": "The Native Feedback Rule",
        "body": "Retain native press, drawer and list feedback; make custom text motion static when Android animations are disabled.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve scalable text, 48dp action targets, meaningful icon descriptions and system/keyboard insets.",
      "Do use scheme-specific content roles for readable controls, messages, history and data surfaces.",
      "Do keep local profile disclosure explicit, preserve optional details and offer Light/Dark/System through native selectable rows.",
      "Do retain full identifiers, units, N/A, source disclosure and expandable notes.",
      "Do preserve fixed comparison labels and synchronized product scrolling.",
      "Do keep the sourced wave decorative and static, with its provenance alongside the native vector."
    ],
    "donts": [
      "Don't restore shortcut rows, a slogan, redundant branding labels or the superseded two-line greeting.",
      "Don't use saturated purple slabs, decorative kickers, hard offset shadows or system display faces.",
      "Don't put wave geometry behind populated chat or animate the background at idle.",
      "Don't add voice, attachments, model selectors, search or unrelated controls.",
      "Don't invent a default identity, imply authentication or add a nonfunctional account-switch action.",
      "Don't place developer traces in release product data or replace semantic content with rasterized text."
    ]
  }
}
