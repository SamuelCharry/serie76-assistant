  "narrative": {
    "northStar": "The Engineering Journal",
    "overview": "A contemporary engineering journal translated into native Android conversation controls. Near-white space, plum ink, fine lilac rules and locally bundled Rethink Sans establish a clear reading hierarchy. The interface leads with the question and gives technical results room to retain their context.\n\nThis records the user-approved Editorial A replacement of V2 as implemented in Kotlin and Jetpack Compose. The scope is light-mode phones, English UI and existing chat, history and development-only debug navigation. Native units remain dp for geometry and sp for text. Screenshot fixtures demonstrate presentation, not a real model or physical-device result.",
    "keyCharacteristics": [
      "Open editorial composition with ruled shortcuts and an outlined white composer.",
      "Regular, medium and semibold Rethink Sans with restrained plum emphasis.",
      "Compact native navigation, fine-stroke vectors and quiet motion.",
      "Complete technical evidence in readable cards and synchronized comparison columns."
    ],
    "rules": [
      {
        "name": "The Plum Action Rule",
        "body": "Use plum for readable small actions and the enabled send control; lilac carries identity and fine structural accents.",
        "section": "colors"
      },
      {
        "name": "The Context Stays Visible Rule",
        "body": "Preserve complete technical identifiers, units, unavailable states and source notes; retain native font scaling rather than shrinking data to fit.",
        "section": "typography"
      },
      {
        "name": "The Native Feedback Rule",
        "body": "Retain native interaction feedback, modal separation and Android animation scaling; do not add perpetual animation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve native scalable text, 48dp action targets, system/keyboard insets and meaningful icon descriptions.",
      "Do use the outlined white composer and ruled text shortcuts established by the editorial world.",
      "Do retain full technical identifiers, units, N/A, source disclosure and expandable notes.",
      "Do preserve fixed comparison labels and synchronized product scrolling.",
      "Do distinguish UI fixture evidence from live model, backend and device verification."
    ],
    "donts": [
      "Don't restore the historical tonal composer or oversized history dashboard.",
      "Don't add decorative kickers, gradients, ornamental imagery, hard offset shadows or system display faces.",
      "Don't introduce voice, attachments, model selectors, search or unrelated controls.",
      "Don't put developer traces in release or inside customer product data.",
      "Don't replace semantic Compose content with screenshot backgrounds or rasterized text."
    ]
  }
