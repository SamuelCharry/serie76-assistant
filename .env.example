# Local development placeholders only. Copy to .env and replace as needed.
POSTGRES_DB=series76
POSTGRES_USER=series76
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
API_PORT=8000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Tool-calling chat model on OpenRouter (see README: model choice). Example: google/gemini-3.6-flash
OPENROUTER_CHAT_MODEL=
# Agent client. The model emits one tool call per turn; answers are rendered by code.
AGENT_MAX_TOKENS=2048
AGENT_REASONING_EFFORT=low
AGENT_TOOL_CHOICE=required
AGENT_TIMEOUT_S=45
# Empty = provider default sampling (as evaluated).
AGENT_TEMPERATURE=
# Optional LangSmith tracing (off by default). When true, prompts, user text and catalogue
# rows of each turn are sent to LangSmith. Key from smith.langchain.com > Settings > API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=serie76-assistant
# US default; EU workspaces use https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Explicit local developer trace access. Keep false outside development.
DEV_DEBUG=false
# Not used: definitions come from a structured glossary (docs/adr/0001). Kept for a future corpus.
OPENROUTER_EMBEDDING_MODEL=
# Optional executable path for local Windows OCR. Docker supplies Tesseract.
TESSERACT_CMD=

# Model evaluation only; private key belongs in ignored .env.
GOOGLE_API_KEY=
