# Local development placeholders only. Copy to .env and replace as needed.
POSTGRES_DB=series76
POSTGRES_USER=series76
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
API_PORT=8000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick and evaluate a model before implementing the agent. No default model yet.
OPENROUTER_CHAT_MODEL=
# Explicit local developer trace access. Keep false outside development.
DEV_DEBUG=false
# Optional only if semantic retrieval is justified.
OPENROUTER_EMBEDDING_MODEL=
# Optional executable path for local Windows OCR. Docker supplies Tesseract.
TESSERACT_CMD=

# Model evaluation only; private key belongs in ignored .env.
GOOGLE_API_KEY=
